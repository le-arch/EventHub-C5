# ==============================================================================
# EventHub Unified Environment Configuration Template
# Instructions: Copy this file to '.env' and update the values for your setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIG (Next.js Build & Runtime)
# ------------------------------------------------------------------------------
# In production/Docker, Next.js runs on port 3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Points to the Go API Gateway
NEXT_PUBLIC_API_URL=http://localhost:8085

# ------------------------------------------------------------------------------
# BACKEND SERVER CONFIG (Golang)
# ------------------------------------------------------------------------------
LISTEN_PORT=8085
# Update this if your frontend port changes (e.g., http://localhost:3000 for Next.js)
FRONTEND_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE CONFIG (PostgreSQL)
# ------------------------------------------------------------------------------
DB_USER=eventhub_user
DB_PASSWORD=your_secure_db_password
DB_HOST=db
DB_PORT=5432
DB_Name=eventhub_db
DB_TLS_DISABLED=true

# Path inside the container for database migrations
MIGRATIONS_PATH=./internal/db/migrations

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_signing_key_change_me
QR_HMAC_SECRET=your_strong_qr_code_hmac_secret_key

# ------------------------------------------------------------------------------
# EMAIL SERVICE (Gmail SMTP)
# ------------------------------------------------------------------------------
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=your_gmail_app_specific_password

# ------------------------------------------------------------------------------
# OBJECT STORAGE CONFIG (MinIO / S3)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=event-images
MINIO_USE_SSL=false

# ------------------------------------------------------------------------------
# OBSERVABILITY & TUNNELING (Grafana & Ngrok)
# ------------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password

# Required for the Ngrok container to expose your local API
NGROK_AUTHTOKEN=your_ngrok_authentication_token_here

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (MTN Mobile Money)
# ------------------------------------------------------------------------------
MTN_MOMO_API_URL=https://sandbox.momodeveloper.com/collection/v1_0
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_momo_subscription_key
MTN_MOMO_API_USER=your_mtn_momo_api_user_guid
MTN_MOMO_API_KEY=your_mtn_momo_api_key
MTN_MOMO_TARGET_ENVIRONMENT=sandbox  
MTN_MOMO_CALLBACK_URL=https://yourdomain.com/api/v1/webhooks/momo
MTN_MOMO_WEBHOOK_SECRET=your_momo_webhook_signature_validation_secret